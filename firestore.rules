rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Assumed data model:
    // projects/{id}: published (bool), order (int), number (string),
    // name (string), description (string), technologies (string list).
    // posts/{id}: published (bool), order (int), category (string),
    // title (string), description (string), date (YYYY-MM-DD string),
    // readingTime (string).
    // Every field is required; documents may not contain extra fields.

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data)
        || request.resource.data.uid == resource.data.uid;
    }

    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.email == 'ronfelara@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isValidProject(data) {
      return data.keys().hasAll([
          'published', 'order', 'number', 'name', 'description', 'technologies'
        ])
        && data.keys().hasOnly([
          'published', 'order', 'number', 'name', 'description', 'technologies'
        ])
        && data.published is bool
        && data.order is int
        && data.order >= 0
        && data.order <= 100000
        && data.number is string
        && data.number.size() > 0
        && data.number.size() <= 10
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 1000
        && data.technologies is list
        && data.technologies.size() > 0
        && data.technologies.size() <= 20
        && data.technologies.hasOnly([
          'Python', 'Delphi', 'Django', 'PySide6', 'Selenium WebDriver',
          'SQL Server', 'MSSQL Server', 'MySQL', 'Oracle', 'Git', 'Bitbucket',
          'Sourcetree', 'Scrum', 'Jira', 'C#', 'Android', 'TDD', 'POO',
          'Design Patterns GoF', 'Regexp', 'HTML', 'CSS', 'TypeScript',
          'Angular', 'JavaScript', 'Java', 'React', 'Node.js', 'Firebase',
          'Firestore', 'Firebase Authentication', 'Acessibilidade',
          'Tailwind CSS', 'Tecnologia 1', 'Tecnologia 2'
        ]);
    }

    function isValidPost(data) {
      return data.keys().hasAll([
          'published', 'order', 'category', 'title', 'description', 'date',
          'readingTime'
        ])
        && data.keys().hasOnly([
          'published', 'order', 'category', 'title', 'description', 'date',
          'readingTime'
        ])
        && data.published is bool
        && data.order is int
        && data.order >= 0
        && data.order <= 100000
        && data.category is string
        && data.category.size() > 0
        && data.category.size() <= 40
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 500
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.readingTime is string
        && data.readingTime.size() > 0
        && data.readingTime.size() <= 30;
    }

    match /projects/{projectId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create: if isAdmin() && uidUnchanged()
        && isValidProject(request.resource.data);
    }

    match /posts/{postId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create: if isAdmin() && uidUnchanged()
        && isValidPost(request.resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
